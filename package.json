{
  "name": "opencode-session-metrics",
  "version": "0.2.2",
  "description": "TUI token usage and cost tracking for OpenCode sessions",
  "keywords": [
    "cost",
    "oc-plugin",
    "opencode",
    "tokens",
    "usage"
  ],
  "homepage": "https://github.com/gerardbalaoro/opencode-session-metrics#readme",
  "bugs": {
    "url": "https://github.com/gerardbalaoro/opencode-session-metrics/issues"
  },
  "license": "MIT",
  "author": "gerardbalaoro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardbalaoro/opencode-session-metrics.git"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./tui": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build": "bun run scripts/build.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0 <1.19.0",
    "@opentui/solid": "^0.4.5",
    "solid-js": "1.9.12"
  },
  "engines": {
    "opencode": ">=1.17.0 <1.19.0"
  },
  "oc-plugin": [
    "tui"
  ]
}
