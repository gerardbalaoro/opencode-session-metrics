{
  "name": "opencode-session-metrics",
  "version": "0.3.1",
  "description": "TUI token usage and cost tracking for OpenCode sessions",
  "keywords": [
    "cost",
    "oc-plugin",
    "opencode",
    "tokens",
    "usage"
  ],
  "homepage": "https://github.com/gerardbalaoro/opencode-session-metrics#readme",
  "bugs": {
    "url": "https://github.com/gerardbalaoro/opencode-session-metrics/issues"
  },
  "license": "MIT",
  "author": "gerardbalaoro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardbalaoro/opencode-session-metrics.git"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#plugin": "./src/plugin.tsx",
    "#command": "./src/command.tsx",
    "#fixtures/*": "./test/fixtures/*.tsx",
    "#components/*": "./src/components/*.tsx",
    "#config": "./src/config.ts",
    "#lib/context": "./src/lib/context.ts",
    "#lib/api": "./src/lib/api.ts",
    "#lib/session": "./src/lib/session.ts",
    "#lib/message-snapshot": "./src/lib/message-snapshot.ts",
    "#lib/metrics-loader": "./src/lib/metrics-loader.ts",
    "#lib/refresh": "./src/lib/refresh.ts",
    "#lib/metrics": "./src/lib/metrics.ts",
    "#lib/metrics-store": "./src/lib/metrics-store.ts",
    "#lib/model-key": "./src/lib/model-key.ts",
    "#lib/pricing": "./src/lib/pricing.ts",
    "#lib/utils": "./src/lib/utils.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs"
    },
    "./tui": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.mjs"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write",
    "lint": "oxlint",
    "prepare": "test ! -e .git || bunx --no-install lefthook install",
    "test": "bun test --conditions browser",
    "test:ui": "bun test --conditions browser test/components",
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run check && bun run test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.4.0",
    "bun-plugin-dts": "^0.4.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.3",
    "zod-compiler": "^2.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0 <2.0.0",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5 <=0.5.1",
    "solid-js": "1.9.12"
  },
  "engines": {
    "opencode": ">=1.18.0 <2.0.0"
  },
  "packageManager": "bun@1.4.0",
  "oc-plugin": [
    "tui"
  ]
}
