{
  "name": "opencode-session-metrics",
  "version": "0.3.1",
  "description": "TUI token usage and cost tracking for OpenCode sessions",
  "keywords": [
    "cost",
    "oc-plugin",
    "opencode",
    "tokens",
    "usage"
  ],
  "homepage": "https://github.com/gerardbalaoro/opencode-session-metrics#readme",
  "bugs": {
    "url": "https://github.com/gerardbalaoro/opencode-session-metrics/issues"
  },
  "license": "MIT",
  "author": "gerardbalaoro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardbalaoro/opencode-session-metrics.git"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#lib/api": "./src/lib/api.ts",
    "#lib/context": "./src/lib/context.ts",
    "#lib/message-snapshot": "./src/lib/message-snapshot.ts",
    "#lib/metrics-loader": "./src/lib/metrics-loader.ts",
    "#lib/metrics": "./src/lib/metrics.ts",
    "#lib/model-key": "./src/lib/model-key.ts",
    "#lib/pricing": "./src/lib/pricing.ts",
    "#lib/session": "./src/lib/session.ts",
    "#lib/utils": "./src/lib/utils.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./tui": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "lint": "oxlint",
    "prepare": "bunx --no-install lefthook install",
    "test": "bun test",
    "build": "bun run scripts/build.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0 <1.19.0",
    "@opentui/solid": ">=0.4.3 <=0.5.1",
    "solid-js": "1.9.12"
  },
  "engines": {
    "opencode": ">=1.17.0 <1.19.0"
  },
  "packageManager": "bun@1.3.14",
  "oc-plugin": [
    "tui"
  ]
}
